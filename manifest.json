{
  "manifest_version": 3,
  "name": "Daily Work Log",
  "version": "1.1.0",
  "description": "Log what you plan to do when the browser starts, track the sites you visit, continue earlier work, download the session, and keep everything synced to Firestore.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "webNavigation",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open work log panel",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "minimum_chrome_version": "114"
}